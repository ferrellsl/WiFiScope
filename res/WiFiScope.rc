// WiFiScope: the icon, the manifest (common controls 6, per-monitor DPI) and the version.
#include <windows.h>

1 ICON "WiFiScope.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "WiFiScope.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Stephen Ferrell"
      VALUE "FileDescription", "WiFiScope - Wi-Fi scanner and channel graphs"
      VALUE "FileVersion", "1.0"
      VALUE "ProductName", "WiFiScope"
      VALUE "ProductVersion", "1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
